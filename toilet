local function refreshPlayerList()
    for _, c in playerList:GetChildren() do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local count = 0
    for _, plr in Players:GetPlayers() do
        if plr ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -4, 0, 26)
            btn.BackgroundColor3 = (selectedPlayer == plr) and PURPLE or BG
            btn.BackgroundTransparency = (selectedPlayer == plr) and 0.1 or 0.3
            btn.Text = "  " .. plr.Name
            btn.TextColor3 = TEXT
            btn.Font = Enum.Font.GothamMedium
            btn.TextSize = 11
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            btn.Parent = playerList
            corner(btn, 6)
            btn.MouseEnter:Connect(function()
                if selectedPlayer ~= plr then tween(btn, 0.15, {BackgroundTransparency = 0.1}) end
            end)
            btn.MouseLeave:Connect(function()
                if selectedPlayer ~= plr then tween(btn, 0.15, {BackgroundTransparency = 0.3}) end
            end)
            btn.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                ddLabel.Text = "Player: " .. plr.Name
                refreshPlayerList()
            end)
        end
    end
    playerList.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 6)
end

