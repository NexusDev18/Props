local function createSetting(parent, y, name, default, min, max, step, callback)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(1, -16, 0, 14)
    label.Position = UDim2.new(0, 10, 0, y)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. default
    label.TextColor3 = TEXT_DIM
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local minus = Instance.new("TextButton", parent)
    minus.Size = UDim2.new(0, 22, 0, 18)
    minus.Position = UDim2.new(0, 10, 0, y + 14)
    minus.BackgroundColor3 = PURPLE_DARK
    minus.BackgroundTransparency = 0.3
    minus.Text = "-"
    minus.TextColor3 = TEXT
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 13
    minus.BorderSizePixel = 0
    corner(minus, 6)

    local valBox = Instance.new("TextBox", parent)
    valBox.Size = UDim2.new(0, 46, 0, 18)
    valBox.Position = UDim2.new(0, 36, 0, y + 14)
    valBox.BackgroundColor3 = BG
    valBox.BackgroundTransparency = 0.2
    valBox.Text = tostring(default)
    valBox.TextColor3 = TEXT
    valBox.Font = Enum.Font.GothamBold
    valBox.TextSize = 11
    valBox.BorderSizePixel = 0
    corner(valBox, 6)
    stroke(valBox, PURPLE, 1, 0.6)

    local plus = Instance.new("TextButton", parent)
    plus.Size = UDim2.new(0, 22, 0, 18)
    plus.Position = UDim2.new(0, 86, 0, y + 14)
    plus.BackgroundColor3 = PURPLE_DARK
    plus.BackgroundTransparency = 0.3
    plus.Text = "+"
    plus.TextColor3 = TEXT
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 13
    plus.BorderSizePixel = 0
    corner(plus, 6)

    local val = default
    local function update(v)
        v = math.max(min, math.min(max, v))
        val = v
        valBox.Text = tostring(v)
        label.Text = name .. ": " .. v
        callback(v)
    end
    minus.MouseButton1Click:Connect(function() update(val - step) end)
    plus.MouseButton1Click:Connect(function() update(val + step) end)
    valBox.FocusLost:Connect(function() update(tonumber(valBox.Text) or val) end)
end

