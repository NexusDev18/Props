local function stopTracking()
    isTracking = false
    if trackingConnection then
        trackingConnection:Disconnect()
        trackingConnection = nil
    end
    toggleBtn.Text = "CONNECT"
    tween(toggleBtn, 0.2, {BackgroundColor3 = PURPLE})
end

toggleBtn.MouseButton1Click:Connect(function()
    if isTracking then
        stopTracking()
        return
    end

    if not selectedPlayer then
        ddLabel.Text = "! Pick a player first"
        task.delay(1.2, function() ddLabel.Text = "Select Player" end)
        return
    end

    pcall(function()
        local args = {"PickingTools", "PropMaker"}
        ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer(unpack(args))
    end)

    notify("Step 1/2", "Click on the 'Furniture' tab in the PropMaker tool!", 4)

    task.delay(3, function()
        notify("Step 2/2", "Select 'Toilet' and click on the ground to place props!", 4)
    end)

    task.delay(6, function()
        propRemotes = {}

        pcall(function() PropsRemote:FireServer("ToggleEditMode") end)
        task.wait(0.5)

        for i = 1, propCount do
            pcall(function() PropsRemote:FireServer("SpawnProp") end)
            task.wait(0.1)
        end

        for _, f in WorkspaceCom:GetChildren() do
            if f.Name:find("Prop") then
                local r = f:FindFirstChild("SetCurrentCFrame")
                if r then table.insert(propRemotes, r) end
            end
        end

        local angles = {}
        for i = 1, #propRemotes do angles[i] = (360 / #propRemotes) * (i - 1) end

        isTracking = true
        toggleBtn.Text = "CONNECTED"
        tween(toggleBtn, 0.2, {BackgroundColor3 = GREEN})

        notify("Tracking Started", "Props are now following " .. selectedPlayer.Name .. "!", 3)

        trackingConnection = RunService.Heartbeat:Connect(function()
            if not isTracking or not selectedPlayer or not selectedPlayer.Character then return end
            local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for i = 1, #propRemotes do
                if propRemotes[i] then
                    angles[i] = (angles[i] + speed) % 360
                    local rad = math.rad(angles[i])
                    local cf = hrp.CFrame * CFrame.new(math.cos(rad) * radius, height, math.sin(rad) * radius)
                    pcall(function() propRemotes[i]:InvokeServer(cf) end)
                end
            end
        end)
    end)
end)

